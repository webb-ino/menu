rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE THIS: put the real staff email addresses here (the same ones you create in Authentication).
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in ['owner@example.com', 'staff@example.com'];
    }

    match /orders/{id} {
      // A customer can open only their own order, because the order ID is long and random.
      allow get: if true;
      // Only staff can list, change or delete orders.
      allow list, update, delete: if isStaff();
      // Anyone can place an order, but only in the exact shape the menu page sends.
      allow create: if request.resource.data.keys().hasOnly(['table','name','note','items','total','status','createdAt'])
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time
        && request.resource.data.table is string
        && request.resource.data.table.size() > 0 && request.resource.data.table.size() <= 10
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 40
        && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 50000;
    }
  }
}
